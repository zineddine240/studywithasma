# Update these with your Supabase details from your project settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-role-key
GEMINI_API_KEY=your_api_key_here

BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# Telegram — instructor notification channel
# Get the bot token from @BotFather, and the chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Vercel Cron Security — protects /api/keep-alive from unauthorized calls
# Set to any random secret string; add the same value in Vercel project env vars
CRON_SECRET=your-random-secret-here